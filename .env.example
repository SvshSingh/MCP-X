# Planner mode: "fixture" replays recorded completions (no API key, no network).
# Anything else uses Gemini and requires GEMINI_API_KEY.
PLANNER_MODE=fixture

# Google Gemini
GEMINI_API_KEY=
# Optional model override; defaults to gemini-3.6-flash
GEMINI_MODEL=

# MCP server port (defaults to 3001)
MCP_PORT=3001

# Twitter / X credentials for the createPost tool.
# Absent credentials are reported as a tool error rather than a crash.
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=
